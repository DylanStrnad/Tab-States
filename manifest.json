{
  "manifest_version": 3,
  "name": "Tab States",
  "version": "1.0",
  "icons": {
    "16": "images/Logo2.png",
    "32": "images/Logo.png",
    "48": "images/Logo.png",
    "128": "images/Logo.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
    "16": "images/Logo2.png",
    "32": "images/Logo2.png"
  }
  },
  "host_permissions": [
    "https://developer.chrome.com/*"
  ],
  
  "permissions": [
    "tabs", "tabGroups", "sessions", "storage"
  ],

  "background": {
    "service_worker": "src/scripts/background.js"
  }

}
